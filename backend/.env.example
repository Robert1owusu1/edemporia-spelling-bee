DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Set to false only for a local/development database using a self-signed TLS certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
# Comma-separated list of allowed browser origins (the frontend host).
FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Public URL of the frontend, used to build verification/reset email links.
APP_URL=http://localhost:3000
# production / development / test. In production, login requires a verified email.
NODE_ENV=development
# Set to the number of proxy hops when running behind a reverse proxy
# (e.g. 1 on Render/Railway/Vercel) so the rate limiter sees real client IPs.
TRUST_PROXY=
# Optional email delivery through Resend. In development, links are returned by the API instead.
RESEND_API_KEY=
EMAIL_FROM="Spelling Bee <no-reply@example.com>"
# The bootstrap platform admin is created (and kept verified) on first boot.
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=use-a-long-unique-secret
GOOGLE_CLIENT_ID=12896868691.......................
GOOGLE_CLIENT_SECRET=GOCSPX................