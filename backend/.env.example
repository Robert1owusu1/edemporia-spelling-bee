# =============================================================================
# Spelling Bee backend -- environment template
#
#   cp .env.example .env
#
# Every entry is KEY=value. Everything below is a placeholder -- replace it
# with your own value. `.env` is gitignored: never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Core -- REQUIRED
# -----------------------------------------------------------------------------
# PostgreSQL connection string (any hosted Postgres works: Supabase, Neon, ...).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spellingbee?schema=public"
# Signs every JWT. Must be at least 32 characters, contain letters AND digits,
# and not be a known weak value -- the server refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-abc123XYZ"

# -----------------------------------------------------------------------------
# Core -- optional (local defaults are fine for development)
# -----------------------------------------------------------------------------
# API port; defaults to 4000 when unset.
PORT=4000
# "development" (default) or "production". Production skips the demo-account
# seed (development only) on startup.
NODE_ENV="development"
# Set to "false" ONLY when your Postgres host requires SSL with a certificate
# the local client cannot verify (common on hosted Postgres).
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
# Comma-separated browser origins allowed by CORS. Defaults to
# localhost/127.0.0.1 on ports 3000 and 5173 when unset.
FRONTEND_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Production -- optional
# -----------------------------------------------------------------------------
# Number of reverse-proxy hops in front of this server (e.g. 1). Required
# behind a load balancer so req.ip -- and therefore the per-IP rate limits --
# is correct. Leave empty when the API is directly exposed (the server rejects
# malformed values at startup).
TRUST_PROXY=""
# Bootstraps (and repairs) the first platform administrator on startup.
# The two must be set together and the password needs 12+ characters.
# Optional: without them no ADMIN account exists until one is created another
# way. Never commit real values.
PLATFORM_ADMIN_EMAIL="admin@example.test"
PLATFORM_ADMIN_PASSWORD="replace-with-a-12-plus-character-password"

# -----------------------------------------------------------------------------
# Password recovery -- optional
# -----------------------------------------------------------------------------
# There is no email delivery: a forgotten password is requested in-app and the
# school administrator resets the account to this default password from the
# admin portal (the owner then changes it in their dashboard). Defaults to
# "SpellingBee123" when unset. Must be at least 8 characters.
DEFAULT_RESET_PASSWORD="SpellingBee123"

# -----------------------------------------------------------------------------
# Rate limiting -- optional
# -----------------------------------------------------------------------------
# When set (and the optional `redis` package is installed) every rate limiter
# enforces one shared budget across instances. Left empty, limits are enforced
# in-process, per instance.
REDIS_URL=""

# -----------------------------------------------------------------------------
# Tests -- optional
# -----------------------------------------------------------------------------
# Base URL used by the end-to-end suite (scripts/e2eTest.js); defaults to
# http://localhost:4000. The suite also needs DATABASE_URL, JWT_SECRET,
# PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD, and a running backend.
API_BASE_URL="http://localhost:4000"
