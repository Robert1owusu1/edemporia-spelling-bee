datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AccountRole {
  PARENT
  TEACHER
  ADMIN
  STUDENT
}

// The thing that actually logs in -- a parent or teacher (or the school
// administrator). Matches the Login screen's email/password flow, which returns
// a *list* of student profiles on success, not a single learner identity.
model Account {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  avatarUrl    String?
  // In-app "forgot password" request: set when the account holder asks for a
  // reset, shown as a badge in the admin portal, cleared when an administrator
  // sets a new (default) password. No email is ever sent -- admin-created
  // accounts are recovered by the administrator directly.
  passwordResetRequestedAt DateTime?
  passwordHash String
  role         AccountRole @default(PARENT)
  approvedAt   DateTime?
  // Bumped on password change or "log out everywhere" to invalidate all
  // previously issued JWTs. Verified against the DB on every request.
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now())

  students     Student[]
  classrooms   Classroom[] @relation("ClassroomTeacher")
  auditLogs    AuditLog[]
  preferences  AccountPreference?
}

// A child profile under an Account -- this is what actually plays the
// game and holds gamification state (points/streak/hearts/tier).
// One Account can have several Students (siblings, or a teacher's class).
model Student {
  id              String   @id @default(uuid())
  accountId       String
  name            String
  studentCode     String   @unique
  age             Int
  className       String
  currentTier     Int      @default(1)
  hearts          Int      @default(5)
  // Last time a heart was lost/regenerated. Hearts refill lazily at 1 per
  // 15 minutes measured from this stamp (see services/studentStateService).
  heartsUpdatedAt DateTime @default(now())
  // Round combo: +1 per correct word, reset to 0 on a wrong word, capped at 50.
  streak          Int      @default(0)
  // Consecutive UTC practice days: +1 per new practice day, unchanged on the
  // same day, reset to 1 after a gap. Independent of the round combo.
  dailyStreak     Int      @default(0)
  lastPracticeDay String?  // YYYY-MM-DD (UTC) of the last scored activity
  // Placement quiz is one-time: once completed the endpoint returns 409.
  placementCompleted Boolean @default(false)
  points          Int      @default(0)
  avatarColor     String?
  avatarUrl       String?
  lastActiveAt    DateTime @default(now())
  classroomId     String?
  createdAt       DateTime @default(now())

  // Account -> Student is deliberately RESTRICT: learners must be deleted
  // explicitly (admin account deletion / deleteStudent), never as a side
  // effect of removing an account row.
  account  Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  classroom Classroom?    @relation(fields: [classroomId], references: [id])
  progress Progress[]
  badges   StudentBadge[]
  preferences StudentPreference?
  dailyChallenges DailyChallengeCompletion[]
  sessions PracticeSession[]

  @@index([accountId])
  @@index([className])
  @@index([studentCode])
  @@index([classroomId])
}

model Word {
  id              String   @id @default(uuid())
  text            String // normalised to lower case on every write path
  tier            Int // difficulty tier -- the only progression axis for now
  category        String? // optional topic tag (e.g. "Animals", "Science")
  definition      String
  exampleSentence String
  createdAt       DateTime @default(now())

  progress Progress[]
  dailyChallenges DailyChallengeCompletion[]

  @@index([tier])
  @@index([text])
  @@unique([text])
}

model Progress {
  id        String   @id @default(uuid())
  studentId String
  wordId    String
  correct   Boolean
  attempts  Int      @default(1)
  createdAt DateTime @default(now())

  // Student children cascade so deleting a learner keeps its history together.
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Word -> Progress is deliberately RESTRICT: learner history must never be
  // destroyed by deleting content (deleteWord refuses used words instead).
  word    Word    @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([wordId])
}

model Badge {
  id          String @id @default(uuid())
  name        String @unique
  description String
  criteria    String // simple machine-readable rule, e.g. "streak:7"

  students StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
}

model Classroom {
  id        String   @id @default(uuid())
  name      String
  grade     String?
  teacherId String
  createdAt DateTime @default(now())

  teacher Account @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  students Student[]

  @@index([teacherId])
}

model StudentPreference {
  id               String   @id @default(uuid())
  studentId        String   @unique
  darkMode         Boolean  @default(false)
  textSize         String   @default("normal")
  updatedAt        DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Account-level preferences that sync across a parent/teacher's devices.
model AccountPreference {
  id          String   @id @default(uuid())
  accountId   String   @unique
  darkMode    Boolean  @default(false)
  dyslexiaFont Boolean @default(false)
  textSize    String   @default("normal")
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model DailyChallengeCompletion {
  id        String   @id @default(uuid())
  studentId String
  date      String   // pure UTC calendar day, YYYY-MM-DD (also the uniqueness key)
  wordId    String?  // optional: the word may be removed later (SET NULL)
  correct   Boolean
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  word    Word?   @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([wordId])
}

model AuditLog {
  id        String   @id @default(uuid())
  accountId String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([action, createdAt])
}

// Lightweight activity ledger: how long a learner spent on a round, used to
// power "hours spent" stats for parents, teachers and the admin dashboard.
model PracticeSession {
  id              String   @id @default(uuid())
  studentId       String
  source          String   @default("PRACTICE") // PRACTICE | TIER | ACTIVITY
  durationSeconds Int      @default(0)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
}